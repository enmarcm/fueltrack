# ============================================
# FuelTrack - Environment Variables
# ============================================
# Copy this file to .env and customize

# PostgreSQL
DB_PASSWORD="CHANGE_ME_SECURE_PASSWORD"

# JWT secrets
JWT_ACCESS_SECRET="CHANGE_ME_RANDOM_64_HEX_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_RANDOM_64_HEX_CHARS"

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:8080"

# API URL (for the client to call the backend)
VITE_API_URL="http://localhost:8081"
