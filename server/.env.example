# Server environment variables (for local development without Docker)
# Copy to .env and customize:
#   cp .env.example .env

DATABASE_URL="postgresql://fueltrack:CHANGE_ME_DB_PASSWORD@localhost:5432/fueltrack?schema=public"
JWT_ACCESS_SECRET="CHANGE_ME_LOCAL_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_LOCAL_REFRESH_SECRET"
PORT=8081
CLIENT_URL="http://localhost:8080"
