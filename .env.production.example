# ============================================
# FuelTrack - Production Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.production.example .env
# ============================================

# PostgreSQL
DB_PASSWORD="CHANGE_ME_GENERATE_A_SECURE_PASSWORD_32_CHARS"

# JWT secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET="CHANGE_ME_RANDOM_64_HEX_CHARS_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_RANDOM_64_HEX_CHARS_REFRESH_SECRET"

# Frontend URL (for CORS)
CLIENT_URL="http://your-domain.com:8080"
